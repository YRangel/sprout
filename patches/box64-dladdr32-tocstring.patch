From 089eab6d787313972e5e538eeab80dcb906ba219 Mon Sep 17 00:00:00 2001
From: YRangel <YRangel@users.noreply.github.com>
Date: Mon, 21 Sep 2026 00:39:15 -0500
Subject: [PATCH] [BOX32] dladdr: copy dli_fname/dli_sname through to_cstring()
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

to_ptrv() truncates native heap strings >4GB; guests canonicalizing
dli_fname (wine's loader: realpath(info.dli_fname) in init_paths)
SIGSEGV inside my32_realpath. to_cstring() strdup's into the 32-bit
arena with a hash cache — the pattern getpwent/freetype wrappers
already use. Fixes wine-11.18 i386 startup (dlopen ntdll.so ->
dladdr(init_paths) -> realpath) on arm64 hosts.
---
 src/wrapped32/wrappedlibdl.c | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/src/wrapped32/wrappedlibdl.c b/src/wrapped32/wrappedlibdl.c
index 50a93eb80..5dc5c8d54 100755
--- a/src/wrapped32/wrappedlibdl.c
+++ b/src/wrapped32/wrappedlibdl.c
@@ -75,10 +75,15 @@ int my32_dladdr1(x64emu_t* emu, void *addr, void *i, void** extra_info, int flag
     void* base = NULL;
     const char* sname = FindSymbolName(my_context->maplib, addr, &start, NULL, &fname, &base, &lib);
     info->dli_saddr = to_ptrv(start);
-    info->dli_fname = to_ptrv((void*)fname);
+    /* fname/sname are NATIVE strings living in box64's own heap (library
+     * bookkeeping) — to_ptrv() truncates them, and guests that canonicalize
+     * dli_fname (wine's loader: realpath(info.dli_fname)) SIGSEGV. Copy
+     * through to_cstring(), which strdup's into the 32-bit arena and caches
+     * (the exact pattern getpwent/freetype wrappers already use). */
+    info->dli_fname = to_cstring((void*)fname);
     info->dli_fbase = to_ptrv(base);
     // TODO: If dli_sname points to native_name, how do I avoid data tampering during usage?
-    info->dli_sname = to_ptrv((void*)sname);
+    info->dli_sname = to_cstring((void*)sname);
     printf_log(LOG_DEBUG, "     dladdr return saddr=%p, fname=\"%s\", sname=\"%s\"\n", start, sname?sname:"", fname?fname:"");
     if(flags==RTLD_DL_SYMENT) {
         printf_log(LOG_INFO, "Warning, unimplement call to dladdr1 with RTLD_DL_SYMENT flags\n");
-- 
